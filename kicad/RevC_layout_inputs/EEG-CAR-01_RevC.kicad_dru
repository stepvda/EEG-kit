(version 1)

# EEG-CAR-01 Rev C -- custom design rules
# GENERATED by tools/rules.py from tools/design.py. Do not edit.
# Board 150 x 130 mm, four layers, through vias only.
# The rule sheet these implement is LAY-EEG-034. Where the two disagree,
# tools/rules.py governs and both are wrong until regenerated.

# ---------------------------------------------------------------- vias
(rule "through_vias_only"
  (constraint disallow buried_via micro_via))

(rule "via_size_fixed"
  (constraint via_diameter (min 0.6mm) (opt 0.6mm) (max 0.6mm))
  (condition "A.Type == 'Via'"))

(rule "via_hole_fixed"
  (constraint hole_size (min 0.3mm) (opt 0.3mm) (max 0.3mm))
  (condition "A.Type == 'Via'"))

# finding 1 -- no drill inside a pad.  physical_hole_clearance is used rather
# than hole_clearance because a via in its own net's pad is the case that has to
# be caught, and net-aware clearance rules skip it.
(rule "no_via_in_smd_pad"
  (constraint physical_hole_clearance (min 0.15mm))
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'"))

# ---------------------------------------------------------------- net classes
# ELECTRODE
#   Patient-connected. **The clearance, the layer and the via restriction are
#   requirements, not proposals.** DSN-EEG-003 section 3.3 rule 3 reads: every
#   electrode net is routed on L1 with the reference plane continuous beneath
#   it, at 0.35 mm clearance to any other net rather than 0.20 mm. The 0.35 mm
#   is transcribed from that sentence and from the electrode-net clearance row
#   of section 3.2; L1-only is transcribed from it word for word; and the via
#   prohibition follows from both halves of it, because a net routed wholly on
#   L1 has no via to place and a via would break the plane it is routed over.
#   It is achievable -- the harness socket J14, the R/D/C protection rows and
#   the module sockets J2/J4/J23/J29 are all on the top side. **What IS a
#   proposal is the width pair**, and only that: no governing document fixes a
#   width for these nets. Section 3.2 gives the board a 0.20 mm floor and a
#   0.25 mm preferred width and says nothing about the electrode class. The
#   0.25 mm minimum is set above the board floor because Rev B only reached
#   0.20 mm on these nets by relaxing, and a patient-connected conductor is
#   the last place to spend the last 0.05 mm. Current is not the constraint:
#   these carry microamperes.
(rule "width_ELECTRODE"
  (constraint track_width (min 0.25mm) (opt 0.3mm))
  (condition "A.NetClass == 'ELECTRODE'"))

(rule "clearance_ELECTRODE"
  (constraint clearance (min 0.35mm) (opt 0.4mm))
  (condition "A.NetClass == 'ELECTRODE'"))

(rule "layers_ELECTRODE"
  (constraint disallow track)
  (condition "A.NetClass == 'ELECTRODE' && !(A.Layer == 'F.Cu')"))

(rule "no_vias_ELECTRODE"
  (constraint disallow via)
  (condition "A.NetClass == 'ELECTRODE'"))

# ANALOGUE_REF
#   AGND_REF, AVDD, AVSS and the module-2 pair. About 10 mA per rail (ICD-
#   EEG-006 section 2.1), so 0.20 mm would carry it four times over: the width
#   is for source impedance and for the mid-rail's noise, not for current.
#   0.40 mm preferred is what the Rev B router already aimed at.
(rule "width_ANALOGUE_REF"
  (constraint track_width (min 0.3mm) (opt 0.4mm))
  (condition "A.NetClass == 'ANALOGUE_REF'"))

(rule "clearance_ANALOGUE_REF"
  (constraint clearance (min 0.2mm) (opt 0.3mm))
  (condition "A.NetClass == 'ANALOGUE_REF'"))

# POWER
#   VSYS, VBAT, V5V, VBUS_CHG, VBUS_IN, DVDD3V3, VDD_ISO, DGND. The worst case
#   is about 610 mA at J13 (ICD-EEG-006 section 2.7, calculated). On 35 um
#   outer copper at a 10 C rise, IPC-2221 gives about 1.29 A for 0.40 mm and
#   about 0.89 A for 0.25 mm, so 0.40 mm is the floor with margin and 0.80 mm
#   is the preferred width the Rev B router already used.
(rule "width_POWER"
  (constraint track_width (min 0.4mm) (opt 0.8mm))
  (condition "A.NetClass == 'POWER'"))

(rule "clearance_POWER"
  (constraint clearance (min 0.2mm) (opt 0.3mm))
  (condition "A.NetClass == 'POWER'"))

# USB
#   DSN-EEG-003 section 3.3 rule 5, transcribed and not proposed: a 0.30 mm
#   pair on 0.35 mm spacing on L1 directly over the DGND plane on L2, about 95
#   ohm differential. The width is the impedance, so it is a fixed value and
#   not a minimum; a via would move the reference and is not permitted.
(rule "width_USB"
  (constraint track_width (min 0.3mm) (opt 0.3mm))
  (condition "A.NetClass == 'USB'"))

(rule "clearance_USB"
  (constraint clearance (min 0.35mm) (opt 0.35mm))
  (condition "A.NetClass == 'USB'"))

(rule "layers_USB"
  (constraint disallow track)
  (condition "A.NetClass == 'USB' && !(A.Layer == 'F.Cu')"))

(rule "no_vias_USB"
  (constraint disallow via)
  (condition "A.NetClass == 'USB'"))

# ANALOGUE
#   Envelope-detector nodes, the microphone and headphone paths, the
#   comparator. Signal nets at high impedance; 0.25 mm is the board's
#   preferred width and there is no reason for these to be narrower than that.
(rule "width_ANALOGUE"
  (constraint track_width (min 0.25mm) (opt 0.25mm))
  (condition "A.NetClass == 'ANALOGUE'"))

(rule "clearance_ANALOGUE"
  (constraint clearance (min 0.2mm) (opt 0.3mm))
  (condition "A.NetClass == 'ANALOGUE'"))

# LED_DRIVE
#   1.3 mA per site and 10.4 mA on the LED_V common (ICD-EEG-006 section 2.11,
#   calculated), so current is nowhere near the constraint. These run to a
#   harness connector and out of the box, which is the reason not to route
#   them at the 0.20 mm floor.
(rule "width_LED_DRIVE"
  (constraint track_width (min 0.25mm) (opt 0.3mm))
  (condition "A.NetClass == 'LED_DRIVE'"))

(rule "clearance_LED_DRIVE"
  (constraint clearance (min 0.2mm) (opt 0.25mm))
  (condition "A.NetClass == 'LED_DRIVE'"))

# DIGITAL
#   SPI, I2S, I2C, SDMMC, UART and the control lines. Logic-level,
#   milliamperes.
(rule "width_DIGITAL"
  (constraint track_width (min 0.2mm) (opt 0.25mm))
  (condition "A.NetClass == 'DIGITAL'"))

(rule "clearance_DIGITAL"
  (constraint clearance (min 0.2mm) (opt 0.25mm))
  (condition "A.NetClass == 'DIGITAL'"))

# DEFAULT
#   Everything the classes above do not name: test points, spare ways, no-
#   connects, the harness screen, the button and reset lines.
(rule "width_DEFAULT"
  (constraint track_width (min 0.2mm) (opt 0.25mm))
  (condition "A.NetClass == 'DEFAULT'"))

(rule "clearance_DEFAULT"
  (constraint clearance (min 0.2mm) (opt 0.25mm))
  (condition "A.NetClass == 'DEFAULT'"))

# ---------------------------------------------------------------- areas
# finding: DSN-EEG-003 section 3.3 rule 4.  Nothing at all inside the strip,
# on any of the four copper layers.
(rule "isolation_keepout"
  (constraint disallow track via zone pad graphic hole footprint)
  (condition "A.insideArea('ISOLATION_KEEPOUT')"))

# DSN-EEG-003 section 3.3 rule 1.  The zone split is a routing rule and not a
# placement rule: a class may have pads on both sides where the circuit demands
# it, and CMP_RAW crosses by design through R83 and D23.
(rule "zoning_DIGITAL_out_of_analogue"
  (constraint disallow track via)
  (condition "A.NetClass == 'DIGITAL' && A.insideArea('ANALOGUE_ZONE')"))

(rule "zoning_POWER_out_of_analogue"
  (constraint disallow track via)
  (condition "A.NetClass == 'POWER' && A.insideArea('ANALOGUE_ZONE')"))

(rule "zoning_LED_DRIVE_out_of_analogue"
  (constraint disallow track via)
  (condition "A.NetClass == 'LED_DRIVE' && A.insideArea('ANALOGUE_ZONE')"))

(rule "zoning_USB_out_of_analogue"
  (constraint disallow track via)
  (condition "A.NetClass == 'USB' && A.insideArea('ANALOGUE_ZONE')"))

(rule "zoning_ELECTRODE_out_of_digital"
  (constraint disallow track via)
  (condition "A.NetClass == 'ELECTRODE' && A.insideArea('DIGITAL_ZONE')"))

(rule "zoning_ANALOGUE_REF_out_of_digital"
  (constraint disallow track via)
  (condition "A.NetClass == 'ANALOGUE_REF' && A.insideArea('DIGITAL_ZONE')"))

# DSN-EEG-003 section 3.3 rule 7: no via under an analogue module connector.
(rule "no_via_under_J2"
  (constraint disallow via)
  (condition "A.insideArea('NO_VIA_J2')"))

(rule "no_via_under_J4"
  (constraint disallow via)
  (condition "A.insideArea('NO_VIA_J4')"))

(rule "no_via_under_J23"
  (constraint disallow via)
  (condition "A.insideArea('NO_VIA_J23')"))

(rule "no_via_under_J29"
  (constraint disallow via)
  (condition "A.insideArea('NO_VIA_J29')"))

# ---------------------------------------------------------------- board floor
(rule "edge_clearance"
  (constraint edge_clearance (min 0.25mm))
  (condition "A.Type != 'Zone'"))

(rule "annular_ring"
  (constraint annular_width (min 0.15mm)))

# ---------------------------------------------------------------- NOT CHECKED HERE
# KiCad has no constraint for either of these and neither is expressible above.
# They are checked by tools/drc.py on the board that comes back, and LAY-EEG-034
# section 6 says so against each of them:
#   finding 3  no angle below 90 degrees between two segments of one track,
#              and every segment on a 0, 45, 90 or 135 degree axis;
#   finding 4  a track enters a pad within 25 % of the pad's minor dimension
#              of the pad centre, measured on the track's centreline.
# Findings 2a and 2b -- dangling ends and redundant copper loops -- are KiCad
# BUILT-IN checks and are raised to errors in the .kicad_pro, not here.

		(uuid "462b5d21-6a07-58c0-ac7b-cc670d4fcbde")
	)
	(text "USB_DP and USB_DN are a 0.30 mm pair on 0.35 mm spacing on L1 over the L2 DGND plane, about 95"
		(exclude_from_sim no)
		(at 20 165 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "62b26dec-e15f-5ba4-ae1e-a440c3d59d9f")
	)
	(text "600 R at 100 MHz, 500 mA (ECO-EEG-031)"
		(exclude_from_sim no)
		(at 200 72 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "8b187b43-9c48-5179-982d-453c85eb35a5")
	)
	(text "it is the copper keep-out of DSN-EEG-003 section 3.3 rule 4: x >= 141.0 mm, y = 2.0 to 22.0 mm,"
		(exclude_from_sim no)
		(at 20 27.12 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "e2322cb6-c637-50ca-9942-fc939289bb30")
	)
	(text "The 2.5 kV barrier is ON THE ADuM4160 MODULE at J10 and not on this board. What the carrier owes"
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "e40003f4-1d60-5ab7-b520-b078013018ec")
	)
	(text "5)."
		(exclude_from_sim no)
		(at 20 171.24 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
